# ElevenDE - Windows 11 Fluent light Openbox theme (global window chrome)

# Geometry
padding.width: 8
padding.height: 3
border.width: 1
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.button.width: 46
window.button.height: 32
window.button.spacing: 0
menu.border.width: 1
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
menu.overlap.x: 0
menu.overlap.y: 0
osd.border.width: 1

# Borders
window.active.border.color: #e5e7eb
window.inactive.border.color: #eceef1
window.active.title.separator.color: #e8eaed
window.inactive.title.separator.color: #f0f1f3
window.active.client.color: #f9fafb
window.inactive.client.color: #f9fafb
menu.border.color: #d9d9d9
osd.border.color: #c9c9c9

# Active window
window.label.text.justify: Left
window.active.title.bg: Solid Flat
window.active.title.bg.color: #f9fafb
window.active.label.bg: Parentrelative
window.active.label.text.color: #1f1f1f
window.active.handle.bg: Solid Flat
window.active.handle.bg.color: #ffffff
window.active.grip.bg: Parentrelative

# Active window buttons
window.active.button.unpressed.bg: Parentrelative
window.active.button.unpressed.image.color: #3b3b3b
window.active.button.hover.bg: Solid Flat
window.active.button.hover.bg.color: #e9e9e9
window.active.button.hover.image.color: #111111
window.active.button.pressed.bg: Solid Flat
window.active.button.pressed.bg.color: #dcdcdc
window.active.button.pressed.image.color: #202020
window.active.button.disabled.bg: Parentrelative
window.active.button.disabled.image.color: #565d6b
window.active.button.toggled.unpressed.bg: Parentrelative
window.active.button.toggled.unpressed.image.color: #9fc1ea
window.active.button.toggled.hover.bg: Solid Flat
window.active.button.toggled.hover.bg.color: #3c6598
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.toggled.pressed.bg: Solid Flat
window.active.button.toggled.pressed.bg.color: #2c466b
window.active.button.toggled.pressed.image.color: #c6ccd6

# Windows 11 per-button hover states: only Close becomes red; Minimize and
# Maximize use a neutral grey hover surface.
window.active.button.close.hover.bg: Solid Flat
window.active.button.close.hover.bg.color: #e81123
window.active.button.close.hover.image.color: #ffffff
window.active.button.close.pressed.bg: Solid Flat
window.active.button.close.pressed.bg.color: #c50f1f
window.active.button.close.pressed.image.color: #ffffff
window.active.button.max.hover.bg: Solid Flat
window.active.button.max.hover.bg.color: #e9e9e9
window.active.button.max.hover.image.color: #111111
window.active.button.max.pressed.bg: Solid Flat
window.active.button.max.pressed.bg.color: #dcdcdc
window.active.button.max.pressed.image.color: #202020
window.active.button.iconify.hover.bg: Solid Flat
window.active.button.iconify.hover.bg.color: #e9e9e9
window.active.button.iconify.hover.image.color: #111111
window.active.button.iconify.pressed.bg: Solid Flat
window.active.button.iconify.pressed.bg.color: #dcdcdc
window.active.button.iconify.pressed.image.color: #202020

# Inactive window
window.inactive.title.bg: Solid Flat
window.inactive.title.bg.color: #f9fafb
window.inactive.label.bg: Parentrelative
window.inactive.label.text.color: #5f6368
window.inactive.handle.bg: Solid Flat
window.inactive.handle.bg.color: #f7f7f7
window.inactive.grip.bg: Parentrelative

# Inactive window buttons
window.inactive.button.unpressed.bg: Parentrelative
window.inactive.button.unpressed.image.color: #777777
window.inactive.button.hover.bg: Solid Flat
window.inactive.button.hover.bg.color: #e9e9e9
window.inactive.button.hover.image.color: #333333
window.inactive.button.pressed.bg: Solid Flat
window.inactive.button.pressed.bg.color: #dcdcdc
window.inactive.button.pressed.image.color: #555555
window.inactive.button.disabled.bg: Parentrelative
window.inactive.button.disabled.image.color: #565d6b
window.inactive.button.toggled.unpressed.bg: Parentrelative
window.inactive.button.toggled.unpressed.image.color: #9fc1ea
window.inactive.button.toggled.hover.bg: Solid Flat
window.inactive.button.toggled.hover.bg.color: #3a4356
window.inactive.button.toggled.hover.image.color: #e8ebef
window.inactive.button.toggled.pressed.bg: Solid Flat
window.inactive.button.toggled.pressed.bg.color: #2b2f39
window.inactive.button.toggled.pressed.image.color: #8a93a2

window.inactive.button.close.hover.bg: Solid Flat
window.inactive.button.close.hover.bg.color: #e81123
window.inactive.button.close.hover.image.color: #ffffff
window.inactive.button.close.pressed.bg: Solid Flat
window.inactive.button.close.pressed.bg.color: #c50f1f
window.inactive.button.close.pressed.image.color: #ffffff
window.inactive.button.max.hover.bg: Solid Flat
window.inactive.button.max.hover.bg.color: #e9e9e9
window.inactive.button.max.hover.image.color: #111111
window.inactive.button.max.pressed.bg: Solid Flat
window.inactive.button.max.pressed.bg.color: #dcdcdc
window.inactive.button.max.pressed.image.color: #202020
window.inactive.button.iconify.hover.bg: Solid Flat
window.inactive.button.iconify.hover.bg.color: #e9e9e9
window.inactive.button.iconify.hover.image.color: #111111
window.inactive.button.iconify.pressed.bg: Solid Flat
window.inactive.button.iconify.pressed.bg.color: #dcdcdc
window.inactive.button.iconify.pressed.image.color: #202020

# Menus (root menu + client menu)
menu.title.bg: Solid Flat
menu.title.bg.color: #f3f3f3
menu.title.text.color: #202020
menu.title.text.justify: Left
menu.items.bg: Solid Flat
menu.items.bg.color: #ffffff
menu.items.text.color: #202020
menu.items.disabled.text.color: #a0a0a0
menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #e5f1fb
menu.items.active.text.color: #202020
menu.items.active.disabled.text.color: #9a9a9a
menu.separator.color: #e5e5e5

# OSD (Alt-Tab / feedback popups)
osd.bg: Solid Flat
osd.bg.color: #ffffff
osd.label.bg: Parentrelative
osd.label.text.color: #202020
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #dbeeff
osd.unhilight.bg: Solid Flat
osd.unhilight.bg.color: #f3f3f3

# Text shadows
window.active.label.text.font: shadow=y:shadowtint=20:shadowoffset=1
window.inactive.label.text.font: shadow=n
menu.items.font: shadow=n
menu.title.text.font: shadow=n
osd.label.text.font: shadow=y:shadowtint=30:shadowoffset=1