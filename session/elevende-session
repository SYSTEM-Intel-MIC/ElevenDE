#!/bin/sh
# ElevenDE 3.0 X11 session. Launch:  startx /usr/local/bin/elevende-session
#
# Paint a base background, run the native C/Xlib shell in the background,
# then run Openbox in the foreground. The session lasts exactly as long as
# Openbox; on exit (Log Out -> `openbox --exit`) the shell is stopped.

export XDG_CURRENT_DESKTOP=ElevenDE
export XDG_SESSION_TYPE=x11
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

SHARE_DIR=/usr/local/share/elevende-shell
USER_CFG_DIR="$HOME/.config/elevende"

if [ -f /etc/X11/Xresources.d/elevende ]; then
    xrdb -merge /etc/X11/Xresources.d/elevende 2>/dev/null || true
fi

# startx console login has no session bus; provide one for the notify daemon
# and for applications (notify-send, GTK/Qt AppIndicator, etc.)
DBUS_PID=""
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
    if eval "$(dbus-launch --sh-syntax 2>/dev/null)"; then
        DBUS_PID="$DBUS_SESSION_BUS_PID"
    fi
fi
export DBUS_SESSION_BUS_ADDRESS
export DBUS_SESSION_BUS_PID

xsetroot -solid "#113d6b" 2>/dev/null || true

# Login gate: show a Win11-style login screen with a password field before
# the desktop starts. Skips (or continues) if the lock cannot run.
if [ -x /usr/local/bin/elevende-lock ]; then
    echo "elevende-session: login gate"
    /usr/local/bin/elevende-lock --login || true
    echo "elevende-session: unlocked"
fi

echo "elevende-session: starting compositor (picom)"
if command -v picom >/dev/null 2>&1; then
    if [ -f "$SHARE_DIR/picom.conf" ]; then
        picom --config "$SHARE_DIR/picom.conf" \
        >/tmp/elevende-picom.log 2>&1 &
    else
        picom >/tmp/elevende-picom.log 2>&1 &
    fi
    COMPOSITOR_PID=$!
fi

echo "elevende-session: starting shell"
/usr/local/bin/elevende-shell >/tmp/elevende-shell.log 2>&1 &
SHELL_PID=$!

echo "elevende-session: starting notification daemon"
if [ -x /usr/local/bin/elevende-notifyd ]; then
    /usr/local/bin/elevende-notifyd >/tmp/elevende-notifyd.log 2>&1 &
    NOTIFY_PID=$!
fi

echo "elevende-session: starting SAS screen daemon (Ctrl+Alt+Delete)"
if [ -x /usr/local/bin/sas-screen ]; then
    /usr/local/bin/sas-screen --config "$SHARE_DIR/sas-config.json" \
        >/tmp/elevende-sas.log 2>&1 &
    SAS_PID=$!
fi

# Regenerate Openbox rc.xml from the shortcut database (system defaults +
# user overrides from the Settings app). 3.4.2 introduces a marker because
# existing user-level rc.xml files may retain the old broken titlebar bindings.
echo "elevende-session: generating shortcut bindings"
mkdir -p "$USER_CFG_DIR"
if [ -x /usr/local/bin/elevende-keybind ]; then
    /usr/local/bin/elevende-keybind --apply >/tmp/elevende-keybind.log 2>&1 || true
fi
if [ ! -f "$USER_CFG_DIR/rc.xml" ] || \
   ! grep -q 'ELEVENDE-RC-REV: 3.4.2-input-routing' "$USER_CFG_DIR/rc.xml"; then
    echo "elevende-session: refreshing legacy Openbox mouse bindings"
    if [ -f "$SHARE_DIR/rc.template.xml" ]; then
        cp "$SHARE_DIR/rc.template.xml" "$USER_CFG_DIR/rc.xml"
    else
        cp "$SHARE_DIR/rc.xml" "$USER_CFG_DIR/rc.xml"
    fi
fi
RC_FILE="$USER_CFG_DIR/rc.xml"

echo "elevende-session: starting Openbox ($RC_FILE)"
openbox --config-file "$RC_FILE"
rc=$?

echo "elevende-session: Openbox exited ($rc), stopping session"
kill "$SHELL_PID" 2>/dev/null || true
wait "$SHELL_PID" 2>/dev/null || true
[ -n "${NOTIFY_PID:-}" ] && kill "$NOTIFY_PID" 2>/dev/null || true
[ -n "${SAS_PID:-}" ] && kill "$SAS_PID" 2>/dev/null || true
[ -n "${COMPOSITOR_PID:-}" ] && kill "$COMPOSITOR_PID" 2>/dev/null || true
[ -n "${DBUS_PID:-}" ] && kill "$DBUS_PID" 2>/dev/null || true
exit $rc
