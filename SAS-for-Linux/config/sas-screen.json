{
    "注释": "按钮 → 外部命令映射。command 为空则该按钮不显示；footer.network 的 command 为空表示打开应用内网络面板。exitAfter: 点击后是否关闭 SAS 界面。",
    "buttons": {
        "锁定": {
            "command": "loginctl",
            "args": ["lock-session"],
            "exitAfter": true
        },
        "注销": {
            "command": "loginctl",
            "args": ["terminate-session", "self"],
            "fallback": [
                { "command": "qdbus6", "args": ["org.kde.ksmserver", "/KSMServer", "logout", "0", "0", "0"] },
                { "command": "qdbus", "args": ["org.kde.ksmserver", "/KSMServer", "logout", "0", "0", "0"] },
                { "command": "gnome-session-quit", "args": ["--logout", "--no-prompt"] },
                { "command": "niri", "args": ["msg", "action", "quit"] },
                { "command": "swaymsg", "args": ["exit"] },
                { "command": "hyprctl", "args": ["dispatch", "exit"] }
            ],
            "exitAfter": true
        },
        "更改密码": {
            "command": "xdg-terminal-exec",
            "args": ["passwd"],
            "fallback": [
                { "command": "kitty", "args": ["-e", "passwd"] },
                { "command": "alacritty", "args": ["-e", "passwd"] },
                { "command": "gnome-terminal", "args": ["--", "passwd"] },
                { "command": "konsole", "args": ["-e", "passwd"] },
                { "command": "xterm", "args": ["-e", "passwd"] }
            ],
            "exitAfter": true
        },
        "任务管理器": {
            "command": "missioncenter",
            "args": [],
            "fallback": [
                { "command": "gnome-system-monitor", "args": [] },
                { "command": "ksysguard", "args": [] },
                { "command": "xfce4-taskmanager", "args": [] }
            ],
            "exitAfter": true
        }
    },
    "footer": {
        "input": {
            "command": "ibus",
            "args": ["engine"],
            "fallback": [
                { "command": "fcitx5", "args": ["-n", "keyboard"] }
            ],
            "注释": "切换输入法"
        },
        "network": {
            "command": "",
            "args": [],
            "注释": "打开应用内 Wi-Fi 切换面板（自动识别 NetworkManager/iwd 后端）"
        },
        "accessibility": {
            "command": "plasma-open-settings",
            "args": ["accessibility"],
            "fallback": [
                { "command": "systemsettings", "args": ["kcm_access"] },
                { "command": "gnome-control-center", "args": ["universal-access"] }
            ]
        }
    }
}
